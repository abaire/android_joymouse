    <string name="config_modifiers_info_title">Modifiers</string>
    <string name="config_modifiers_info_description">Modifiers (Shift and Alt) are controller buttons that you can hold down while pressing another button to trigger alternate actions.\n\nShift and Alt must be assigned to different buttons.\n\nThe toggle shortcut is used to enable or disable JoyMouse. This is primarily used to allow Android apps with controller support to receive input as though JoyMouse was not installed.</string>
    <string name="config_special_actions_info_title">Special actions</string>
    <string name="config_special_actions_info_description">Special actions provide controller shortcuts for Android system navigation, mouse settings, and display cycling. Each action is triggered by pressing a single button, optionally combined with holding the Shift or Alt modifier.</string>
