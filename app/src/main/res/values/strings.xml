    <string name="operating_instructions_action_back">• `SELECT` or `B`: `BACK`</string>
    <string name="operating_instructions_action_home">• `MODE`: `HOME`</string>
    <string name="operating_instructions_action_start">• `START`: `START`</string>
    <string name="operating_instructions_action_activate">• `A`: `ACTIVATE`</string>
    <string name="operating_instructions_action_display_backward">• `LEFT SHOULDER`: switch to previous display device</string>
    <string name="operating_instructions_action_display_forward">• `RIGHT SHOULDER`: switch to next display device</string>
    <string name="operating_instructions_action_cycle_device">• `SELECT`: choose active controller</string>
    <string name="operating_instructions_action_swipe_up">• `DPAD-UP`: `fling up`</string>
    <string name="operating_instructions_action_swipe_down">• `DPAD-DOWN`: `fling down`</string>
